  "narrative": {
    "northStar": "The Chart Recorder",
    "overview": "Every Machine is a sheet from a strip-chart recorder. The pen rests at the current reading, and the last 24 hours trace out behind it on chart paper whose grid is the real scale. The page answers 'is everything OK?' with a verdict sentence, then lets each sheet confirm it. Cool green-grey paper, graphite text, one pen ink per channel, one reserved red, ochre for high. Archivo only: normal width for words, 88% width tabular for readings.",
    "keyCharacteristics": [
      "Chart-paper ground, hairline-edged flat sheets, no glass, no gradients, no glow.",
      "One pen ink per channel; one reserved red; one ochre.",
      "State is always in words as well as color.",
      "Big readings (2rem) beside their trace; labels small and grey.",
      "The pen dot sits at the trace's live end; an Offline pen is lifted (hollow)."
    ],
    "rules": [
      {
        "name": "The Reserved Red Rule",
        "body": "Red appears only for readings at 90 % or more (and the matching verdict numeral). Offline, stopped and reconnecting are never red.",
        "section": "colors"
      },
      {
        "name": "The Printed-Where-It-Runs Rule",
        "body": "Grid ink exists only inside a trace or a drive track. It is never a page background or texture.",
        "section": "colors"
      },
      {
        "name": "The Words-Too Rule",
        "body": "No state is carried by color alone; pair it with a word or a filled/hollow shape.",
        "section": "colors"
      },
      {
        "name": "The Two Widths Rule",
        "body": "Readings use the 88 % width with tabular figures; words stay at normal width. Do not mix.",
        "section": "typography"
      },
      {
        "name": "The One Sentence Rule",
        "body": "The page has one display-size line and it is a complete sentence about the state of the Machines.",
        "section": "typography"
      },
      {
        "name": "The Flat Sheet Rule",
        "body": "A sheet is a hairline-ringed rectangle. Depth is told by fill (Sheet vs. paper vs. transparent), not by shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do put the verdict sentence first and let sheets confirm it.",
      "Do color a reading, its trace, and its pen together by level: ink, ochre from 80 %, red from 90 %.",
      "Do say state in words next to the dot or color.",
      "Do keep the trace axis the real scale: 24 h across, 0-100 % up, grid every 3 h and 25 %.",
      "Do use the 88 % width with tabular figures for every live number.",
      "Do keep Offline sheets legible but receding: transparent fill, Pencil Grey, hollow pen.",
      "Do use the `sheets` grid and a 2px focus ring on every interactive element."
    ],
    "donts": [
      "Don't build a stat-tile admin grid: badge, KPI tile, decorative sparkline.",
      "Don't use red for anything below 90 % or for Offline, stopped, or reconnecting.",
      "Don't print grid ink as a page background, or add gradients, glass, or glow.",
      "Don't add a theme toggle; follow the system setting.",
      "Don't add a primary action to the page; Retry exists only for an unreachable server.",
      "Don't interpolate across an Offline gap in a trace.",
      "Don't use the Machine terms host, node, device, stats, or health in copy; use Machine, Usage, Online, Offline, Last seen, History."
    ]
  }
}