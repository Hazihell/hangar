#!/usr/bin/env bash
# Manage this machine's agent setup from the ~/.agents repo.
# Run `hangar help` for the commands.
set -euo pipefail

REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")/.." && pwd)"
BACKUP_ROOT="$HOME/.hangar-backup"
T3_CHANNEL="${HANGAR_T3_CHANNEL:-nightly}"
OS="$(uname -s)"

# Linked into place: tools only read these, so edits land in the repo.
# Each line: <path in repo>|<path on this machine>
LINKS="
claude/CLAUDE.md|$HOME/.claude/CLAUDE.md
claude/agents|$HOME/.claude/agents
claude/hooks|$HOME/.claude/hooks
claude/statusline-command.sh|$HOME/.claude/statusline-command.sh
skills|$HOME/.claude/skills
cast/cast.md|$HOME/.codex/AGENTS.md
bin/hangar|$HOME/.local/bin/hangar
"
# Copied, not linked: Claude Code rewrites this file when you change a setting
# and can replace a symlink with a plain file. `sync` carries it both ways.
SETTINGS_REPO="$REPO/claude/settings.json"
SETTINGS_LIVE="$HOME/.claude/settings.json"
# The last version of this machine's settings already in the repo: the base
# for merging a change made here with one that came from the other machine.
SETTINGS_SEEN="$HOME/.claude/.hangar-settings-seen"
apply_settings() { cp "$SETTINGS_REPO" "$SETTINGS_LIVE"; cp "$SETTINGS_REPO" "$SETTINGS_SEEN"; }

if [ -t 1 ]; then G=$'\e[32m' Y=$'\e[33m' R=$'\e[31m' D=$'\e[2m' N=$'\e[0m'; else G= Y= R= D= N=; fi
ok()   { printf '  %sok%s    %s\n' "$G" "$N" "$*"; }
warn() { printf '  %swarn%s  %s\n' "$Y" "$N" "$*"; WARNED=1; }
bad()  { printf '  %sfail%s  %s\n' "$R" "$N" "$*"; FAILED=1; }
say()  { printf '%s\n' "$*"; }
WARNED=0 FAILED=0

is_wsl() { grep -qi microsoft /proc/version 2>/dev/null; }
is_number() { [[ "${1:-}" =~ ^-?[0-9]+(\.[0-9]+)?$ ]]; }

# ── Tailscale ─────────────────────────────────────────────────────────────────
# On the PC, Tailscale runs in Windows; Ubuntu has none of its own, and the Dashboard answers the tailnet itself (see README).
ts() { if is_wsl; then "$C_DRIVE/Program Files/Tailscale/tailscale.exe" "$@"; else tailscale "$@"; fi; }

# ── Temperature ───────────────────────────────────────────────────────────────
# The PC's CPU temperature comes from HWiNFO64, which a logon task starts with admin rights; the Mac's from a helper built here.
C_DRIVE="${HANGAR_C_DRIVE:-/mnt/c}"   # where WSL mounts C:; tests point it at a stub
HWINFO_TASK="Hangar HWiNFO"
MAC_TEMPS="$HOME/.local/state/hangar/temps"
winps() { "$C_DRIVE/Windows/System32/WindowsPowerShell/v1.0/powershell.exe" -NoProfile -NonInteractive "$@"; }

hwinfo_task() { "$C_DRIVE/Windows/System32/schtasks.exe" /query /tn "$HWINFO_TASK" >/dev/null 2>&1; }
hwinfo_cpu() { # the CPU temperature HWiNFO reports to Gadget, found by label as the collector does; nothing if it isn't
  winps -Command 'try { $v = Get-ItemProperty -Path HKCU:\Software\HWiNFO64\VSB -ErrorAction Stop; $l = @($v.PSObject.Properties | Where-Object { $_.Name -match "^Label\d+$" -and $_.Value -eq "CPU (Tctl/Tdie)" })[0]; if ($l) { $v.("ValueRaw" + $l.Name.Substring(5)) } } catch { }' 2>/dev/null | tr -d '\r'
}
gpu_temp() { # the first GPU's temperature; nothing without an NVIDIA driver
  timeout 5 /usr/lib/wsl/lib/nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits 2>/dev/null | head -n 1
}

ini_get() { # ini_get <section> <key> <file>: value of key inside [section]
  tr -d '\r' < "$3" | awk -v sec="$1" -v key="$2" '
    /^[ \t]*\[/ { gsub(/[][ \t]/, ""); cur = $0; next }
    cur == sec {
      line = $0; sub(/[#;].*/, "", line)
      n = index(line, "="); if (!n) next
      k = substr(line, 1, n - 1); v = substr(line, n + 1)
      gsub(/^[ \t]+|[ \t]+$/, "", k); gsub(/^[ \t]+|[ \t]+$/, "", v)
      if (k == key && !found) { val = v; found = 1 }   # read on: an early exit breaks the pipe under pipefail
    }
    END { if (found) print val }'
}

add_gh_repo() { # GitHub's own apt source: Ubuntu's gh package lags far behind
  local list=/etc/apt/sources.list.d/github-cli.list key=/etc/apt/keyrings/githubcli-archive-keyring.gpg
  [ -f "$list" ] && return 0
  sudo mkdir -p -m 755 /etc/apt/keyrings &&
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | sudo tee "$key" >/dev/null &&
    sudo chmod go+r "$key" &&
    echo "deb [arch=$(dpkg --print-architecture) signed-by=$key] https://cli.github.com/packages stable main" |
      sudo tee "$list" >/dev/null
}

tea_latest_tag() { # newest Gitea CLI release tag, e.g. v0.16.0
  local tag
  tag="$(curl -fsSL --max-time 15 https://gitea.com/api/v1/repos/gitea/tea/releases/latest |
    sed -n 's/.*"tag_name":"\([^"]*\)".*/\1/p' | head -n 1)" || return 1
  [ -n "$tag" ] && printf '%s\n' "$tag"
}

install_tea() { # latest Gitea CLI into ~/.local/bin, checked against its published checksum; it has no apt source
  local tag ver cur arch f url tmp rc=0
  tag="$(tea_latest_tag)" || return 1
  ver="${tag#v}"
  cur="$(tea --version 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | awk '{print $2; exit}' || true)"
  if [ "$cur" = "$ver" ]; then ok "tea $ver"; return 0; fi
  case "$(uname -m)" in x86_64) arch=amd64 ;; aarch64 | arm64) arch=arm64 ;; *) return 1 ;; esac
  f="tea-$ver-linux-$arch.xz"
  url="https://gitea.com/gitea/tea/releases/download/$tag/$f"
  tmp="$(mktemp -d)"
  { curl -fsSL -o "$tmp/$f" "$url" && curl -fsSL -o "$tmp/$f.sha256" "$url.sha256" &&
    (cd "$tmp" && sha256sum -c --quiet "$f.sha256") && xz -d "$tmp/$f" &&
    mkdir -p "$HOME/.local/bin" && install -m 755 "$tmp/${f%.xz}" "$HOME/.local/bin/tea"; } || rc=1
  rm -rf "$tmp"
  [ "$rc" = 0 ] && ok "tea ${cur:+$cur -> }$ver"
  return "$rc"
}

BACKUP_DIR=
backup() { # move a path aside before replacing it; one folder per run
  local src="$1" dest
  if [ -z "$BACKUP_DIR" ]; then
    mkdir -p "$BACKUP_ROOT"
    BACKUP_DIR="$(mktemp -d "$BACKUP_ROOT/$(date +%Y%m%d-%H%M%S)-XXXX")"
  fi
  dest="$BACKUP_DIR${src#"$HOME"}"
  mkdir -p "$(dirname "$dest")"
  mv "$src" "$dest"
  say "  ${D}moved old $src to $dest${N}"
}

# ── Dashboard ─────────────────────────────────────────────────────────────────
dashboard_node() {
  local major unit="$HOME/.config/systemd/user/hangar-dashboard.service" n
  if ! command -v node >/dev/null && [ -f "$unit" ]; then
    # The service's PATH is bare: borrow the node its own unit runs, and the npm beside it.
    n="$(sed -n 's/^ExecStart="\([^"]*\)".*/\1/p' "$unit" | head -n 1)"
    if [ -x "$n" ]; then PATH="$(dirname "$n"):$PATH"; export PATH; fi
  fi
  if ! command -v node >/dev/null; then bad "Dashboard needs Node 24 or newer; install Node first"; return 1; fi
  major="$(node -p 'process.versions.node.split(".")[0]')" || return 1
  if [ "$major" -lt 24 ]; then bad "Dashboard needs Node 24 or newer (found $major)"; return 1; fi
}

build_dashboard() {
  [ -f "$REPO/dashboard/web/package.json" ] || return 0
  say "Dashboard page"
  local tmp rc=0
  tmp="$(mktemp -d "$REPO/dashboard/web/.dist-XXXXXX")" || return 1
  (cd "$REPO/dashboard/web" && npm ci --no-audit --no-fund && npm run build -- --outDir "$tmp") || rc=1
  if [ "$rc" = 0 ]; then
    # Swap in the new build only once it's complete; a failed build keeps the old page.
    local dist="$REPO/dashboard/web/dist"
    rm -rf "$dist.old"
    if [ -e "$dist" ]; then mv "$dist" "$dist.old" || rc=1; fi
    if [ "$rc" = 0 ] && ! mv "$tmp" "$dist"; then
      rc=1; [ -e "$dist.old" ] && mv "$dist.old" "$dist"
    fi
    rm -rf "$dist.old"
  fi
  rm -rf "$tmp"
  return "$rc"
}

write_dashboard_unit() {
  local node unit="$HOME/.config/systemd/user/hangar-dashboard.service" tmp
  dashboard_node || return 1
  node="$(command -v node)"
  mkdir -p "$(dirname "$unit")"
  tmp="$(mktemp)"
  cat > "$tmp" <<EOF
[Unit]
Description=Hangar Dashboard
After=network.target

[Service]
ExecStart="$node" "$REPO/dashboard/server/server.ts"
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
EOF
  if ! cmp -s "$tmp" "$unit"; then
    mv "$tmp" "$unit"
    systemctl --user daemon-reload || return 1
  else rm -f "$tmp"; fi
}

install_dashboard() {
  write_dashboard_unit || return 1
  build_dashboard || warn "Dashboard page build failed; keeping the previous page"
  if systemctl --user enable --now hangar-dashboard.service && systemctl --user restart hangar-dashboard.service; then ok "Dashboard service enabled"
  else warn "Dashboard service failed; check 'systemctl --user status hangar-dashboard.service'"; fi
  if is_wsl; then tailnet_https
  elif ts serve --bg 4318; then ok "Dashboard served through Tailscale"
  else warn "Tailscale serve failed; for permissions run 'sudo tailscale set --operator=$USER', then 'tailscale serve --bg 4318'"; fi
}

# On the PC the Dashboard serves HTTPS on port 443 itself, so Windows' `tailscale serve` must let go of it and Ubuntu must let a user take it.
PORT_SYSCTL=/etc/sysctl.d/60-hangar-dashboard.conf
tailnet_https() {
  if [ "$(sysctl -n net.ipv4.ip_unprivileged_port_start)" -le 443 ]; then ok "Dashboard may listen on port 443"
  elif printf '# The Hangar Dashboard serves HTTPS on port 443 itself (see README).\nnet.ipv4.ip_unprivileged_port_start=443\n' | sudo tee "$PORT_SYSCTL" >/dev/null && sudo sysctl -q -p "$PORT_SYSCTL"; then ok "Dashboard may listen on port 443"
  else warn "couldn't let the Dashboard listen on port 443; run 'hangar install' again"; fi
  if ! grep -qE '127\.0\.0\.1:4318|localhost:4318' <<< "$(ts serve status 2>/dev/null || true)"; then :
  elif ts serve --https=443 off >/dev/null; then ok "Windows' Tailscale no longer proxies the Dashboard"
  else warn "couldn't stop Windows' Tailscale proxying the Dashboard; run 'tailscale serve --https=443 off' in Windows"; fi
}

setup_reporter() {
  local plist="$HOME/Library/LaunchAgents/com.hangar.reporter.plist" script escaped log domain attempt
  script="$REPO/dashboard/reporter/mac-reporter.sh"
  # Escape both XML text and sed's replacement characters, including repo paths with spaces.
  escaped="$(printf '%s' "$script" | sed 's/\&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g; s/[\\&|]/\\&/g')"
  log="$(printf '%s' "$HOME/Library/Logs/hangar-reporter.log" | sed 's/\&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g; s/[\\&|]/\\&/g')"
  mkdir -p "$(dirname "$plist")" "$HOME/Library/Logs"
  sed "s|__REPORTER__|$escaped|g; s|__LOG__|$log|g" "$REPO/dashboard/reporter/com.hangar.reporter.plist" > "$plist"
  domain="gui/$(id -u)"
  launchctl bootout "$domain/com.hangar.reporter" >/dev/null 2>&1 || true
  for ((attempt=0; attempt<20; attempt++)); do
    launchctl print "$domain/com.hangar.reporter" >/dev/null 2>&1 || break
    sleep 0.25
  done
  if launchctl bootstrap "$domain" "$plist" || { sleep 1; launchctl bootstrap "$domain" "$plist"; }; then ok "Dashboard reporter loaded"
  else bad "Dashboard reporter failed to load"; fi
}

setup_hwinfo() {
  say "PC temperature"
  local exe="$C_DRIVE/Program Files/HWiNFO64/HWiNFO64.EXE" appdata dir script
  if hwinfo_task; then ok "HWiNFO64 starts at logon"; return; fi
  if [ ! -f "$exe" ]; then warn "install HWiNFO64 for the PC's CPU temperature, then run 'hangar setup' again"; return; fi
  appdata="$("$C_DRIVE/Windows/System32/cmd.exe" /c 'echo %LOCALAPPDATA%' 2>/dev/null | tr -d '\r' || true)"
  dir="$(wslpath "$appdata" 2>/dev/null || true)/hangar"
  if [ -z "$appdata" ] || ! mkdir -p "$dir" || ! cp "$REPO/dashboard/windows/hwinfo-setup.ps1" "$dir/"; then warn "couldn't copy hwinfo-setup.ps1 to Windows; the PC's CPU temperature isn't set up"; return; fi
  script="$(wslpath -w "$dir/hwinfo-setup.ps1")"
  say "Approve the UAC prompt on the PC's screen"
  if winps -Command "\$p = Start-Process powershell.exe -Verb RunAs -Wait -PassThru -ArgumentList '-NoProfile -ExecutionPolicy Bypass -File \"$script\"'; exit \$p.ExitCode"; then ok "HWiNFO64 set up to start at logon"
  else warn "HWiNFO64 setup didn't finish (UAC declined?); run 'hangar setup' again and approve the prompt"; fi
}

setup_temps() {
  say "Mac temperature"
  local src="$REPO/dashboard/reporter/temps.swift"
  if [ -x "$MAC_TEMPS" ] && [ ! "$src" -nt "$MAC_TEMPS" ]; then ok "CPU temperature helper"; return; fi
  if ! command -v swiftc >/dev/null; then warn "swiftc missing; run 'xcode-select --install' for the Mac's CPU temperature, then 'hangar setup' again"; return; fi
  mkdir -p "$(dirname "$MAC_TEMPS")"
  if swiftc -O "$src" -o "$MAC_TEMPS.new" && mv "$MAC_TEMPS.new" "$MAC_TEMPS"; then ok "CPU temperature helper built"
  else rm -f "$MAC_TEMPS.new"; warn "couldn't build the CPU temperature helper from $src"; fi
}

startup_dir() { # the Windows user's Startup folder, as a WSL path
  local appdata; appdata="$("$C_DRIVE/Windows/System32/cmd.exe" /c 'echo %APPDATA%' 2>/dev/null | tr -d '\r' || true)"
  [ -n "$appdata" ] && printf '%s/Microsoft/Windows/Start Menu/Programs/Startup\n' "$(wslpath "$appdata" 2>/dev/null)"
}

setup_startup() {
  say "Ubuntu at sign-in"
  local dir; dir="$(startup_dir || true)"
  if [ -z "$dir" ]; then warn "couldn't find Windows' Startup folder; Ubuntu won't start by itself after a reboot"; return; fi
  if cmp -s "$REPO/windows/start-ubuntu.cmd" "$dir/start-ubuntu.cmd"; then ok "Windows starts Ubuntu at sign-in"; return; fi
  if mkdir -p "$dir" && cp "$REPO/windows/start-ubuntu.cmd" "$dir/"; then ok "Windows now starts Ubuntu at sign-in"
  else warn "couldn't copy start-ubuntu.cmd to $dir; Ubuntu won't start by itself after a reboot"; fi
}

# Windows counts a wake from the network as unattended and sleeps again after two idle minutes,
# since nobody touches the keyboard or mouse. 0 turns that off: the PC sleeps only when told to.
unattended_sleep() { # the active power plan's unattended sleep timeout on mains, in seconds; nothing if unset
  winps -Command '$g = [regex]::Match((powercfg /getactivescheme), "[0-9a-f-]{36}").Value; (Get-ItemProperty "HKLM:\SYSTEM\CurrentControlSet\Control\Power\User\PowerSchemes\$g\238c9fa8-0aad-41ed-83f4-97be242c8f20\7bc4a2f9-d8fc-4469-b07b-33eb785aaca0" -ErrorAction SilentlyContinue).ACSettingIndex' 2>/dev/null | tr -d '\r'
}

setup_wake() {
  say "Remote wake"
  if [ "$(unattended_sleep)" = 0 ]; then ok "the PC stays awake after a remote wake"; return; fi
  if winps -Command 'powercfg /setacvalueindex SCHEME_CURRENT SUB_SLEEP UNATTENDSLEEP 0; if ($LASTEXITCODE) { exit 1 }; powercfg /setactive SCHEME_CURRENT' >/dev/null 2>&1; then ok "the PC now stays awake after a remote wake"
  else warn "couldn't change Windows' unattended sleep timeout; the PC sleeps again two minutes after a remote wake"; fi
}

# ── setup ─────────────────────────────────────────────────────────────────────
cmd_setup() {
  say "Linking config into place"
  local line rel target src
  while IFS='|' read -r rel target; do
    [ -n "$rel" ] || continue
    src="$REPO/$rel"
    if [ -L "$target" ] && [ "$(readlink "$target")" = "$src" ]; then
      ok "$target"; continue
    fi
    mkdir -p "$(dirname "$target")"
    if [ -e "$target" ] || [ -L "$target" ]; then backup "$target"; fi
    ln -s "$src" "$target"
    ok "$target -> $src"
  done <<< "$LINKS"

  say "Claude settings"
  if [ -L "$SETTINGS_LIVE" ]; then backup "$SETTINGS_LIVE"; fi
  if [ -f "$SETTINGS_LIVE" ] && ! cmp -s "$SETTINGS_LIVE" "$SETTINGS_REPO"; then
    backup "$SETTINGS_LIVE"
  fi
  apply_settings
  ok "$SETTINGS_LIVE matches the repo"

  say "Skill dependencies"
  local pkg dir
  for pkg in "$REPO"/skills/*/package.json; do
    [ -f "$pkg" ] || continue
    dir="$(dirname "$pkg")"
    if [ -f "$dir/node_modules/.hangar-installed" ]; then ok "$(basename "$dir")"; continue; fi
    if ! command -v npm >/dev/null; then
      warn "$(basename "$dir") needs npm; install Node, then run 'hangar setup' again"
    elif (cd "$dir" && npm ci --silent --no-audit --no-fund); then
      touch "$dir/node_modules/.hangar-installed"   # marks a complete install
      ok "$(basename "$dir") installed"
    else
      bad "$(basename "$dir"): npm ci failed"
    fi
  done
  if [ "$OS" = Darwin ]; then setup_temps; setup_reporter; fi
  if is_wsl; then setup_hwinfo; setup_startup; setup_wake; fi
  if [ "$FAILED" = 1 ]; then say "${R}Setup finished with errors.${N}"; exit 1; fi
  say "Done. Run 'hangar doctor' to check the whole machine."
}

# ── sync ──────────────────────────────────────────────────────────────────────
cmd_sync() {
  if [ ! -L "$HOME/.claude/CLAUDE.md" ]; then
    say "This machine isn't set up yet. Run 'hangar setup' first."; exit 1
  fi
  cd "$REPO"
  if [ -d .git/rebase-merge ] || [ -d .git/rebase-apply ]; then
    say "A conflict from the last sync is still open. Fix it in $REPO, run 'git rebase --continue', then sync again."; exit 1
  fi
  if [ -L "$SETTINGS_LIVE" ] || [ ! -f "$SETTINGS_LIVE" ]; then
    say "$SETTINGS_LIVE should be a plain file. Run 'hangar setup' first."; exit 1
  fi
  # 1. bring this machine's settings changes into the repo, if it made any
  if [ ! -f "$SETTINGS_SEEN" ]; then
    if cmp -s "$SETTINGS_LIVE" "$SETTINGS_REPO"; then cp "$SETTINGS_REPO" "$SETTINGS_SEEN"
    else
      say "$SETTINGS_LIVE and the repo's copy differ, and there's no record of which is newer."
      say "Keep the repo's:  hangar setup   (this machine's copy is backed up)"
      say "Keep this one's:  cp $SETTINGS_LIVE $SETTINGS_REPO   then sync again"
      exit 1
    fi
  fi
  local captured; captured="$(mktemp)"; cp "$SETTINGS_LIVE" "$captured"
  if ! cmp -s "$captured" "$SETTINGS_SEEN"; then
    merge_settings "$captured" || exit 1
  fi
  # 2. commit whatever changed here
  git add -A
  if ! git diff --cached --quiet; then
    if ! git commit -q -m "sync from $(hostname -s 2>/dev/null || hostname)"; then
      say "${R}Commit failed.${N} Your changes are staged in $REPO; fix the error above and sync again."; exit 1
    fi
    say "Committed local changes:"
    git show --stat --format= HEAD | sed 's/^/  /'
  else
    say "No local changes."
  fi
  # 3. merge the other machine's changes
  if git remote get-url origin >/dev/null 2>&1; then
    if ! git pull -q --rebase; then
      say "${R}The two machines changed the same lines.${N} Fix the conflicts in $REPO,"
      say "then run 'git rebase --continue' and 'hangar sync' again."; exit 1
    fi
    if ! git push -q; then say "${R}Push failed.${N} Nothing was lost; fix the error above and sync again."; exit 1; fi
    say "Pushed to $(git remote get-url origin)."
  else
    warn "no remote yet; changes are committed here only"
  fi
  # 4. apply the merged settings back, unless Claude Code changed them meanwhile
  if ! cmp -s "$SETTINGS_LIVE" "$captured"; then
    warn "Claude Code changed settings during the sync; kept them. Run 'hangar sync' again to merge."
    rm -f "$captured"; exit 1
  fi
  rm -f "$captured"
  apply_settings
  if [ "$OS" = Linux ] && command -v systemctl >/dev/null && systemctl --user is-active --quiet hangar-dashboard.service 2>/dev/null; then
    systemctl --user restart hangar-dashboard.service || warn "Dashboard restart failed"
  elif [ "$OS" = Darwin ] && command -v launchctl >/dev/null && launchctl print "gui/$(id -u)/com.hangar.reporter" >/dev/null 2>&1; then
    launchctl kickstart -k "gui/$(id -u)/com.hangar.reporter" || warn "Dashboard reporter restart failed"
  fi
  say "Up to date."
}

# Three-way merge of this machine's settings into the repo's copy, based on the
# last version already in the repo from here. Stops if the same lines changed.
merge_settings() {
  local live="$1" merged; merged="$(mktemp)"
  if git merge-file -p "$live" "$SETTINGS_SEEN" "$SETTINGS_REPO" > "$merged"; then
    cp "$merged" "$SETTINGS_REPO"; rm -f "$merged"
    cp "$live" "$SETTINGS_SEEN"   # this machine's change is in the repo now
  else
    rm -f "$merged"
    say "${R}Settings changed in the same place here and in the repo.${N} Nothing was overwritten."
    say "Edit $SETTINGS_REPO to the version you want, copy it to $SETTINGS_LIVE, then sync again."
    say "  ${D}this machine: $SETTINGS_LIVE   last agreed: $SETTINGS_SEEN${N}"
    return 1
  fi
}

# ── doctor ────────────────────────────────────────────────────────────────────
cmd_doctor() {
  say "Repo $REPO"
  cd "$REPO"
  if [ -n "$(git status --porcelain)" ]; then warn "uncommitted changes; run 'hangar sync'"; else ok "clean"; fi
  if git remote get-url origin >/dev/null 2>&1; then
    git fetch -q 2>/dev/null || warn "couldn't reach $(git remote get-url origin)"
    local ab; ab="$(git rev-list --left-right --count HEAD...@{u} 2>/dev/null || echo '? ?')"
    set -- $ab
    if [ "$1" = 0 ] && [ "$2" = 0 ]; then ok "in step with origin"
    else warn "$1 commit(s) to push, $2 to pull; run 'hangar sync'"; fi
  else
    warn "no remote; the other machine can't get these changes"
  fi

  say "Links"
  local rel target
  while IFS='|' read -r rel target; do
    [ -n "$rel" ] || continue
    if [ -L "$target" ] && [ "$(readlink "$target")" = "$REPO/$rel" ]; then ok "$target"
    elif [ -e "$target" ]; then bad "$target is a plain file; run 'hangar setup'"
    else bad "$target missing; run 'hangar setup'"; fi
  done <<< "$LINKS"
  if [ -L "$SETTINGS_LIVE" ]; then bad "$SETTINGS_LIVE is a symlink; run 'hangar setup'"
  elif cmp -s "$SETTINGS_LIVE" "$SETTINGS_REPO" 2>/dev/null; then ok "$SETTINGS_LIVE matches the repo"
  else warn "$SETTINGS_LIVE differs from the repo; run 'hangar sync'"; fi

  say "Tools T3 Code can see (login shell PATH)"
  local tool p
  for tool in git node npm claude codex t3 jq gh tea; do
    p="$(sh -lc "command -v $tool" 2>/dev/null || true)"
    if [ -n "$p" ]; then ok "$tool  ${D}$p${N}"
    elif [ "$tool" = codex ]; then warn "codex not on PATH; fine if you use 'Connect with ChatGPT' in T3"
    elif [ "$tool" = tea ]; then warn "tea not found; needed only for Gitea repos"
    elif [ "$tool" = t3 ] && [ "$OS" = Darwin ]; then ok "t3  ${D}not needed here; the desktop app runs the server${N}"
    elif [ "$tool" = node ] && command -v node >/dev/null; then
      bad "node only works in interactive shells; move your version manager's lines from ~/.bashrc to ~/.profile"
    else bad "$tool not found"; fi
  done

  say "Skill dependencies"
  local pkg
  for pkg in "$REPO"/skills/*/package.json; do
    [ -f "$pkg" ] || continue
    if [ -f "$(dirname "$pkg")/node_modules/.hangar-installed" ]; then ok "$(basename "$(dirname "$pkg")")"
    else bad "$(basename "$(dirname "$pkg")") dependencies not installed; run 'hangar setup'"; fi
  done

  if [ "$OS" = Linux ]; then
    say "T3 Code server"
    if [ "$(ps -p 1 -o comm= 2>/dev/null)" = systemd ]; then ok "systemd running"
    else bad "systemd off; add [boot] systemd=true to /etc/wsl.conf, then 'wsl --shutdown'"; fi
    if sh -lc 'command -v t3' >/dev/null 2>&1; then
      # `t3 service status` exits 0 even when stopped, so ask systemd
      if systemctl --user is-active --quiet t3code.service 2>/dev/null; then ok "background service running"
      else bad "background service not running; run 't3 service status' for the reason"; fi
      if sh -lc 't3 browser setup' 2>&1 | grep -q 'is allowed here'; then ok "browser ready for screenshots"
      else warn "browser may need setup; run 'sudo t3 browser setup'"; fi
    else
      bad "t3 not installed; run 'hangar install'"
    fi
    if is_wsl; then
      say "WSL"
      local winhome cfg
      winhome="$(wslpath "$(/mnt/c/Windows/System32/cmd.exe /c 'echo %USERPROFILE%' 2>/dev/null | tr -d '\r')" 2>/dev/null || true)"
      cfg="$winhome/.wslconfig"
      if [ -f "$cfg" ]; then
        local idle mem
        idle="$(ini_get general instanceIdleTimeout "$cfg")"
        mem="$(ini_get wsl2 memory "$cfg")"
        if [ "$idle" = -1 ]; then ok "Ubuntu stays up when idle"
        else bad "set 'instanceIdleTimeout=-1' under [general] in $cfg, or Ubuntu stops when idle"; fi
        if [ -n "$mem" ]; then ok "memory capped at $mem"
        else warn "no 'memory=' under [wsl2] in $cfg; games may run short of RAM"; fi
      else
        bad "no $cfg; see README for the settings"
      fi
      if [ "$(wslinfo --networking-mode 2>/dev/null)" = mirrored ]; then ok "mirrored networking, so dev servers reach the tailnet"
      else warn "set 'networkingMode=mirrored' under [wsl2] in $cfg, then 'wsl --shutdown'; until then dev servers don't reach the tailnet"; fi
      if systemctl is-active --quiet tailscaled 2>/dev/null; then warn "Tailscale runs inside Ubuntu too; Windows' Tailscale is enough, so run 'sudo tailscale logout && sudo apt purge -y tailscale'"; fi
      local startup; startup="$(startup_dir || true)/start-ubuntu.cmd"
      if cmp -s "$REPO/windows/start-ubuntu.cmd" "$startup"; then ok "Windows starts Ubuntu at sign-in"
      elif [ -f "$startup" ]; then warn "$startup differs from the repo's; run 'hangar setup'"
      else bad "nothing starts Ubuntu at sign-in, so T3 Code and the Dashboard stay down after a reboot; run 'hangar setup'"; fi
      if [ "$(unattended_sleep)" = 0 ]; then ok "the PC stays awake after a remote wake"
      else warn "the PC sleeps again two minutes after a remote wake; run 'hangar setup'"; fi
    fi
  fi

  say "Dashboard"
  if [ "$OS" = Linux ]; then
    if systemctl --user is-active --quiet hangar-dashboard.service 2>/dev/null; then ok "Dashboard service running"
    else bad "Dashboard service stopped; run 'hangar install'"; fi
    local serve_status; serve_status="$(ts serve status 2>/dev/null || true)"
    if is_wsl; then
      local name; name="$(ts status --json 2>/dev/null | jq -r '.Self.DNSName // empty' | sed 's/\.$//')"
      if grep -qE '127\.0\.0\.1:4318|localhost:4318' <<< "$serve_status"; then bad "Windows' Tailscale still proxies the Dashboard, which breaks after sleep; run 'hangar install'"
      elif [ -n "$name" ] && curl -fsS --max-time 5 "https://$name/api/machines" >/dev/null; then ok "Dashboard answers the tailnet at https://$name"
      else bad "Dashboard doesn't answer HTTPS on the tailnet; check 'journalctl --user -u hangar-dashboard'"; fi
    elif grep -qE '127\.0\.0\.1:4318|localhost:4318' <<< "$serve_status"; then ok "Tailscale proxies Dashboard"
    else bad "Tailscale proxy missing; run 'tailscale serve --bg 4318'"; fi
    if curl -fsS --max-time 5 http://127.0.0.1:4318/api/machines >/dev/null; then ok "Dashboard API answers"
    else bad "Dashboard API unreachable"; fi
    if dashboard_node; then
      local vpn_name vpn_target
      while IFS=$'\t' read -r vpn_name vpn_target; do
        [ -n "$vpn_target" ] || continue
        if env -u SSH_AUTH_SOCK ssh -o BatchMode=yes -o ConnectTimeout=5 "$vpn_target" true </dev/null 2>/dev/null; then ok "VPN control reaches $vpn_name"
        else warn "can't SSH to $vpn_name; the Dashboard can't (dis)connect its VPNs"; fi
      done < <(node -e 'for (const m of JSON.parse(require("node:fs").readFileSync(process.argv[1], "utf8"))) if (m.ssh) console.log(m.name + "\t" + m.ssh)' "$REPO/dashboard/machines.json")
    fi
  elif [ "$OS" = Darwin ]; then
    if launchctl print "gui/$(id -u)/com.hangar.reporter" >/dev/null 2>&1; then ok "Dashboard reporter loaded"
    else bad "Dashboard reporter missing; run 'hangar setup'"; fi
    local dashboard_url="${HANGAR_DASHBOARD_URL:-https://stormtrooper.taila332e5.ts.net/api/report}"
    if curl -fsS --max-time 5 "${dashboard_url%/api/report}/api/machines" >/dev/null; then ok "Dashboard reachable"
    else bad "Dashboard unreachable"; fi
  fi

  if is_wsl; then
    say "Temperature"
    local cpu gpu
    if hwinfo_task; then ok "HWiNFO64 starts at logon"
    else warn "no '$HWINFO_TASK' task; run 'hangar setup' on the PC and approve the UAC prompt"; fi
    cpu="$(hwinfo_cpu || true)"
    if is_number "$cpu"; then ok "CPU $cpu °C from HWiNFO64"
    else warn "HWiNFO64 reports no CPU temperature; in HWiNFO, Configure Sensors → HWiNFO Gadget → tick Report value in Gadget for CPU (Tctl/Tdie)"; fi
    gpu="$(gpu_temp || true)"
    if is_number "$gpu"; then ok "GPU $gpu °C from nvidia-smi"
    else warn "nvidia-smi gives no GPU temperature; install the NVIDIA driver on the PC"; fi
  elif [ "$OS" = Darwin ]; then
    say "Temperature"
    local temp
    temp="$("$MAC_TEMPS" 2>/dev/null || true)"
    if is_number "$temp"; then ok "CPU $temp °C"
    else warn "no CPU temperature; run 'hangar setup'"; fi
  fi

  say ""
  if [ "$FAILED" = 1 ]; then say "${R}Some checks failed.${N}"; exit 1
  elif [ "$WARNED" = 1 ]; then say "${Y}Working, with warnings.${N}"
  else say "${G}All good.${N}"; fi
}

# ── updates ───────────────────────────────────────────────────────────────────
# What `update` and `outdated` know how to handle, in the order they're listed.
ITEM_IDS="t3 claude codex gh tea hangar"
item_name() {
  case "$1" in
    t3) echo "T3 Code" ;; claude) echo "Claude Code" ;; codex) echo "Codex" ;;
    gh) echo "GitHub CLI" ;; tea) echo "Gitea CLI" ;; hangar) echo "Hangar" ;;
  esac
}
item_installed() { if [ "$1" = hangar ]; then return 0; else command -v "$1" >/dev/null 2>&1; fi; }

# A terminal has these on PATH; the Dashboard's service and a bare SSH command don't.
tool_path() {
  PATH="$HOME/.local/bin:$PATH"
  if [ "$OS" = Darwin ]; then PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"; fi
  export PATH
}

descendants() { # descendants <pid>: its children, their children and so on
  local c
  for c in $(pgrep -P "$1" 2>/dev/null || true); do echo "$c"; descendants "$c"; done
}
kill_tree() { # kill_tree <signal> <pid>: the process, everything under it, and its process group if it leads one
  local sig="$1" pid="$2" all p
  all="$pid $(descendants "$pid")"   # listed first: once the parent dies, its children are reparented out of sight
  if [ "$(ps -o pgid= -p "$pid" 2>/dev/null | tr -d ' ')" = "$pid" ]; then kill -s "$sig" -- "-$pid" 2>/dev/null || true; fi
  for p in $all; do kill -s "$sig" "$p" 2>/dev/null || true; done
}
run_limit() { # run_limit <seconds> <command...>: stop the whole command tree if it runs longer (KILL after a 2 s grace); prints its output, keeps its exit code
  local secs="$1" out pid watcher rc
  shift
  out="$(mktemp)"
  # Output goes to a file, so a descendant that outlives the deadline can't hold up whoever reads it.
  set -m   # a background job gets its own process group
  "$@" > "$out" < /dev/null & pid=$!
  set +m
  ( sleep "$secs"; kill_tree TERM "$pid"; sleep 2; kill_tree KILL "$pid" ) > /dev/null 2>&1 &
  watcher=$!
  wait "$pid" 2>/dev/null && rc=0 || rc=$?
  kill_tree KILL "$watcher"
  wait "$watcher" 2>/dev/null || true
  cat "$out"; rm -f "$out"
  return "$rc"
}

fetch() { curl -fsSL --max-time 12 "$@"; }
ESC=$'\033'

newer() { # newer <a> <b>: prints 1 if version a is newer than b, comparing their numbers in order
  awk -v a="$1" -v b="$2" 'BEGIN {
    na = split(a, x, /[^0-9]+/); nb = split(b, y, /[^0-9]+/); n = (na > nb ? na : nb)
    for (i = 1; i <= n; i++) { p = x[i] + 0; q = y[i] + 0; if (p > q) { print 1; exit } if (p < q) { print 0; exit } }
    print 0 }'
}

clean_version() { # one plain version word, or nothing
  local v; v="$(printf '%s' "$1" | tr -d '\r' | awk 'NR == 1 {print $1}')"
  v="${v#v}"
  case "$v" in '' | *[!0-9A-Za-z.+~_-]*) return 0 ;; esac
  printf '%s' "$v"
}

installed_version() {
  local out
  case "$1" in
    claude) out="$(run_limit 15 claude --version 2>/dev/null | awk 'NR == 1 {print $1}')" ;;
    codex) out="$(run_limit 15 codex --version 2>/dev/null | awk 'NR == 1 {print $2}')" ;;
    t3) out="$(run_limit 15 t3 --version 2>/dev/null | awk 'NR == 1 {print $2}')" ;;
    gh) out="$(run_limit 15 gh --version 2>/dev/null | awk 'NR == 1 {print $3}')" ;;
    tea) out="$(run_limit 15 tea --version 2>/dev/null | sed "s/$ESC\[[0-9;]*m//g" | awk 'NR == 1 {print $2}')" ;;
  esac
  clean_version "$out"
}

# The newest version each tool's own updater would install.
latest_claude() { # the release channel Claude Code follows: settings' autoUpdatesChannel (stable or latest), default latest
  local channel
  channel="$(sed -n 's/.*"autoUpdatesChannel"[[:space:]]*:[[:space:]]*"\([a-z]*\)".*/\1/p' "$SETTINGS_LIVE" 2>/dev/null | head -n 1)" || true
  [ "$channel" = stable ] || channel=latest
  fetch "https://downloads.claude.ai/claude-code-releases/$channel"
}
latest_codex() { # `codex update` runs OpenAI's installer, which takes the newest rust-v tag
  local body tag
  for body in https://releases.openai.com/codex/channels/latest https://api.github.com/repos/openai/codex/releases/latest; do
    tag="$(fetch "$body" 2>/dev/null | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"rust-v\([^"]*\)".*/\1/p' | head -n 1)" || true
    if [ -n "$tag" ]; then printf '%s' "$tag"; return 0; fi
  done
  return 1
}
latest_t3() { # as `t3 update` does: newest GitHub release on the channel this t3 was published on
  local current="$1" re page found
  case "$current" in
    *-nightly.*) re='^v[0-9]+\.[0-9]+\.[0-9]+-nightly\.[0-9]+\.[0-9]+$' ;;
    *-preview.*) re='^v[0-9]+\.[0-9]+\.[0-9]+-preview\.[0-9]+\.[0-9]+$' ;;
    *) re='^v[0-9]+\.[0-9]+\.[0-9]+$' ;;
  esac
  for page in 1 2 3; do
    found="$(fetch "https://api.github.com/repos/pingdotgg/t3code/releases?per_page=100&page=$page" 2>/dev/null |
      sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | RE="$re" awk '!f && $0 ~ ENVIRON["RE"] {print; f = 1}')" || true
    if [ -n "$found" ]; then printf '%s' "$found"; return 0; fi
  done
  return 1
}
latest_gh_apt() { # apt's candidate, after refreshing the indexes when sudo allows it without asking
  if sudo -n true 2>/dev/null; then run_limit 40 sudo -n apt-get update -q >/dev/null 2>&1 || true; fi
  apt-cache policy gh 2>/dev/null | awk '/Candidate:/ {print $2; exit}' | sed -E 's/^[0-9]+://; s/-.*$//; s/^\(none\)$//'
}

blocked_gh() { # the Dashboard has no terminal to type a sudo password into
  if [ "$OS" = Linux ] && ! sudo -n true 2>/dev/null; then echo "Needs sudo; run 'hangar update' on the PC"; fi
}
blocked_hangar() {
  local branch
  branch="$(git -C "$REPO" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  if [ "$branch" != main ]; then echo "Checkout is on '${branch:-?}', not main"
  elif [ -n "$(git -C "$REPO" status --porcelain 2>/dev/null)" ]; then echo "Local changes in the checkout; run 'hangar sync'"
  elif [ "$(git -C "$REPO" rev-list --count origin/main..HEAD 2>/dev/null || echo 0)" != 0 ]; then echo "Local commits not on origin/main; run 'hangar sync'"; fi
}

# One record per line: id, current, latest, available, blocked, behind, separated by the ASCII unit separator
# (git branch names, which end up in `blocked`, can hold any printable character but not control ones).
record() { # record <id> <current> <latest> [behind]; blocked only matters for an update that could run
  local id="$1" cur="$2" latest="$3" behind="${4:-}" avail=false blocked=""
  case "$behind" in '' | *[!0-9]*) behind="" ;; esac
  if [ "$id" = hangar ]; then
    if [ -n "$behind" ] && [ "$behind" -gt 0 ]; then avail=true; fi
  elif [ -n "$cur" ] && [ -n "$latest" ] && [ "$(newer "$latest" "$cur")" = 1 ]; then avail=true; fi
  if [ "$avail" = true ]; then
    case "$id" in gh | hangar) blocked="$(blocked_"$id" | head -n 1)" ;; esac
  fi
  blocked="$(printf '%s' "$blocked" | tr -d '\000-\037')"
  printf '%s\037%s\037%s\037%s\037%s\037%s\n' "$id" "$cur" "$latest" "$avail" "$blocked" "$behind"
}

check_item() {
  local id="$1" cur latest="" behind=""
  case "$id" in
    hangar)
      cur="$(git -C "$REPO" rev-parse --short HEAD 2>/dev/null || true)"
      if GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh} -o BatchMode=yes" run_limit 20 git -C "$REPO" fetch -q origin main </dev/null >/dev/null 2>&1; then
        latest="$(git -C "$REPO" rev-parse --short origin/main 2>/dev/null || true)"
        behind="$(git -C "$REPO" rev-list --count HEAD..origin/main 2>/dev/null || true)"
      fi ;;
    *)
      cur="$(installed_version "$id" || true)"
      case "$id" in
        claude) latest="$(latest_claude || true)" ;;
        codex) latest="$(latest_codex || true)" ;;
        t3) latest="$(latest_t3 "$cur" || true)" ;;
        gh) latest="$(latest_gh_apt || true)" ;;
        tea) latest="$(tea_latest_tag || true)" ;;
      esac
      latest="$(clean_version "$latest")" ;;
  esac
  record "$id" "$cur" "$latest" "$behind"
}

check_brewed() { # gh and tea on the Mac come from Homebrew: one index refresh, one outdated list
  local out id cur latest have=
  command -v brew >/dev/null 2>&1 || return 0
  for id in gh tea; do if item_installed "$id"; then have="$have $id"; fi; done
  [ -n "$have" ] || return 0
  run_limit 40 brew update -q >/dev/null 2>&1 || true
  # shellcheck disable=SC2086
  out="$(run_limit 40 brew outdated --formula --verbose $have 2>/dev/null)" || true
  for id in $have; do
    cur="$(installed_version "$id" || true)"
    # "gh (2.101.0) < 2.102.0" when behind; nothing when current
    latest="$(printf '%s\n' "$out" | awk -v n="$id" '$1 == n {print $NF}')"
    latest="$(clean_version "${latest:-$cur}")"
    record "$id" "$cur" "$latest" > "$OUTDATED_DIR/$id.rec"
  done
}

json_str() { printf '"%s"' "$(printf '%s' "$1" | tr -d '\000-\037' | sed 's/\\/\\\\/g; s/"/\\"/g')"; }
json_or_null() { if [ -n "$1" ]; then json_str "$1"; else printf null; fi; }

cmd_outdated() {
  local json=0 arg id tmp sep= rid cur latest avail blocked behind
  for arg in "$@"; do
    case "$arg" in --json) json=1 ;; *) say "usage: hangar outdated [--json]"; exit 2 ;; esac
  done
  tool_path
  tmp="$(mktemp -d)"; OUTDATED_DIR="$tmp"
  # Each item resolves on its own, at once, so a slow or failing one costs only itself.
  for id in $ITEM_IDS; do
    if [ "$OS" = Darwin ] && { [ "$id" = gh ] || [ "$id" = tea ]; }; then
      if [ "$id" = gh ]; then ( set +e; check_brewed ) 2>/dev/null & fi
      continue
    fi
    item_installed "$id" || continue
    { ( set +e; check_item "$id" > "$tmp/$id.rec" ) 2>/dev/null || true; [ -s "$tmp/$id.rec" ] || record "$id" "" "" > "$tmp/$id.rec"; } &
  done
  wait
  if [ "$json" = 1 ]; then printf '{"items":['; fi
  for id in $ITEM_IDS; do
    [ -s "$tmp/$id.rec" ] || continue
    IFS=$'\037' read -r rid cur latest avail blocked behind < "$tmp/$id.rec" || true
    if [ "$json" = 1 ]; then
      printf '%s{"id":%s,"name":%s,"current":%s,"latest":%s,"available":%s,"blocked":%s' "$sep" "$(json_str "$id")" "$(json_str "$(item_name "$id")")" "$(json_or_null "$cur")" "$(json_or_null "$latest")" "$avail" "$(json_or_null "$blocked")"
      if [ "$id" = hangar ]; then printf ',"behind":%s' "${behind:-null}"; fi
      printf '}'; sep=,
    elif [ "$avail" = true ]; then
      printf '  %s%-8s%s %s -> %s%s\n' "$Y" "$id" "$N" "${cur:-?}" "$latest" "${blocked:+  ($blocked)}"
    else
      printf '  %s%-8s%s %s%s\n' "$G" "$id" "$N" "${cur:-unknown}" "$([ -z "$latest" ] && echo "  (couldn't check for newer)")"
    fi
  done
  if [ "$json" = 1 ]; then printf ']}\n'; fi
  rm -rf "$tmp"
  return 0
}

# ── update ────────────────────────────────────────────────────────────────────
# Each returns non-zero on failure, and may leave a short reason in WHY for the Dashboard.
WHY=
update_claude() { claude update; }
update_codex() { codex update 2>/dev/null || { WHY="codex update failed; rerun its installer"; return 1; }; }
update_t3() { t3 update "$@"; }
update_gh() {
  local s=(sudo)
  [ -t 0 ] || s=(sudo -n)   # nobody to type a password
  if [ "$OS" = Linux ]; then
    "${s[@]}" apt-get update -q >/dev/null && "${s[@]}" apt-get install -y -q --only-upgrade gh >/dev/null &&
      ok "gh $(gh --version | awk 'NR == 1 {print $3}')"
  else brew_upgrade gh; fi
}
update_tea() { if [ "$OS" = Linux ]; then install_tea; else brew_upgrade tea; fi; }
brew_upgrade() {
  command -v brew >/dev/null || return 0
  brew list --formula "$1" >/dev/null 2>&1 || return 0
  brew upgrade -q "$1"
}

# After the checkout moves to new code, rebuild what runs from it.
refresh_hangar() {
  if [ "$OS" = Linux ]; then
    write_dashboard_unit || return 1
    build_dashboard || { WHY="Pulled, but the Dashboard page build failed"; return 1; }
  fi
}
# The very last step: on Linux it restarts the Dashboard server, which may be what's running this.
restart_dashboard() {
  if [ "$OS" = Linux ]; then
    systemctl --user --no-block restart hangar-dashboard.service || warn "Dashboard restart failed; run 'hangar install'"
  elif command -v launchctl >/dev/null && launchctl print "gui/$(id -u)/com.hangar.reporter" >/dev/null 2>&1; then
    launchctl kickstart -k "gui/$(id -u)/com.hangar.reporter" || warn "Dashboard reporter restart failed"
  fi
}
HANGAR_UPDATED=
update_hangar() {
  local branch
  if [ "$OS" = Linux ]; then dashboard_node >/dev/null || { WHY="Dashboard needs Node 24 or newer"; return 1; }; fi
  branch="$(git -C "$REPO" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  if [ "$branch" != main ]; then WHY="Hangar: checkout is on '${branch:-?}', not main"; return 1; fi
  if [ -n "$(git -C "$REPO" status --porcelain)" ]; then WHY="Hangar: local changes in the checkout; run 'hangar sync'"; return 1; fi
  GIT_TERMINAL_PROMPT=0 git -C "$REPO" pull -q --ff-only origin main </dev/null || { WHY="Hangar: git pull failed"; return 1; }
  ok "Hangar $(git -C "$REPO" rev-parse --short HEAD)"
  # The new code does the rebuilding: this shell still holds the old functions.
  bash "$REPO/bin/hangar" _refresh || { WHY="${WHY:-Hangar pulled, but rebuilding the Dashboard failed}"; return 1; }
  HANGAR_UPDATED=1
}

# One `hangar update` at a time per machine. The lock is a symlink named for the holder's pid: creating it is
# atomic everywhere (macOS bash 3.2 included), and it is stale once that process is gone.
UPDATE_LOCK="$HOME/.local/state/hangar/update.lock"
take_update_lock() {
  local holder try
  mkdir -p "$(dirname "$UPDATE_LOCK")"
  for try in 1 2; do
    if ln -s "$$" "$UPDATE_LOCK" 2>/dev/null; then trap 'rm -f "$UPDATE_LOCK"' EXIT; return 0; fi
    holder="$(readlink "$UPDATE_LOCK" 2>/dev/null || true)"
    if [ -n "$holder" ] && kill -0 "$holder" 2>/dev/null; then
      printf 'Another hangar update is already running (pid %s)\n' "$holder" >&2; return 1
    fi
    [ "$(readlink "$UPDATE_LOCK" 2>/dev/null || true)" = "$holder" ] && rm -f "$UPDATE_LOCK"
  done
  printf 'Another hangar update is already running\n' >&2; return 1
}

update_items() { # update_items <id>...: just those, in order; Hangar itself last
  local id seen=" " failed="" order=
  for id in "$@"; do
    case " $ITEM_IDS " in *" $id "*) ;; *) say "unknown item: $id"; return 2 ;; esac
    case "$seen" in *" $id "*) say "item given twice: $id"; return 2 ;; esac
    seen="$seen$id "
  done
  for id in "$@"; do [ "$id" = hangar ] || order="$order $id"; done
  case "$seen" in *" hangar "*) order="$order hangar" ;; esac
  for id in $order; do
    WHY=
    say "$(item_name "$id")"
    if ! item_installed "$id"; then WHY="$(item_name "$id") isn't installed here"
    else
      case "$id" in
        t3) update_t3 --yes ;; claude) update_claude ;; codex) update_codex ;;
        gh) update_gh ;; tea) update_tea ;; hangar) update_hangar ;;
      esac || { [ -n "$WHY" ] || WHY="$(item_name "$id") update failed"; }
    fi
    if [ -n "$WHY" ]; then bad "$WHY"; failed="${failed:+$failed; }$WHY"; fi
  done
  if [ -n "$failed" ]; then printf '%s\n' "$failed" >&2; fi
  if [ -n "$HANGAR_UPDATED" ]; then restart_dashboard; fi   # only once the new code is pulled and rebuilt
  [ -z "$failed" ]
}

cmd_update() {
  tool_path
  take_update_lock || return 1
  if [ $# -gt 0 ]; then [ -t 0 ] || exec < /dev/null; update_items "$@"; return; fi
  if [ "$OS" = Linux ]; then dashboard_node || return 1; fi
  say "Claude Code"
  if ! command -v claude >/dev/null; then say "  skipped (not installed)"
  elif ! update_claude; then warn "claude update failed"; fi
  say "Codex"
  if ! command -v codex >/dev/null; then say "  skipped (not installed)"
  elif ! update_codex; then warn "codex update failed; rerun its installer"; fi
  say "Skills from the skills installer"
  (cd "$HOME" && npx -y skills update -g -y) || warn "skills update failed"
  say "T3 Code (asks before restarting, since that interrupts running agents)"
  if ! command -v t3 >/dev/null; then say "  skipped (no t3 command here)"
  elif ! update_t3; then warn "t3 update failed"; fi
  say "gh and tea"
  if [ "$OS" = Linux ]; then
    if ! command -v gh >/dev/null; then say "  gh skipped (not installed)"
    elif ! update_gh; then warn "gh update failed"; fi
    if ! command -v tea >/dev/null; then say "  tea skipped (not installed)"
    else update_tea || warn "tea update failed"; fi
  elif command -v brew >/dev/null; then
    local f
    for f in gh tea; do brew_upgrade "$f" || warn "brew upgrade $f failed"; done
  fi
  if [ "$OS" = Linux ]; then
    write_dashboard_unit || return 1
    build_dashboard || warn "Dashboard page build failed; keeping the previous page"
    systemctl --user restart hangar-dashboard.service || warn "Dashboard restart failed; run 'hangar install'"
  fi
  cd "$REPO"
  if [ -n "$(git status --porcelain skills)" ]; then
    say ""; say "Skill updates changed these files. Review with 'git -C $REPO diff', then 'hangar sync':"
    git status --short skills | sed 's/^/  /'
  fi
}

# ── install (Linux only) ──────────────────────────────────────────────────────
cmd_install() {
  [ "$OS" = Linux ] || { say "'install' sets up a fresh Linux server. On the Mac use 'setup'."; exit 1; }
  export PATH="$HOME/.local/bin:$PATH"
  dashboard_node || return 1
  say "System packages"
  add_gh_repo || warn "couldn't add GitHub's apt source; installing Ubuntu's older gh instead"
  sudo apt-get update -q && sudo apt-get install -y -q build-essential python3 git curl unzip xz-utils jq gh
  say "tea (Gitea CLI)"
  install_tea || warn "tea install failed; get it from https://gitea.com/gitea/tea/releases"
  say "Claude Code"
  command -v claude >/dev/null || curl -fsSL https://claude.ai/install.sh | bash
  say "Codex"
  command -v codex >/dev/null || curl -fsSL https://chatgpt.com/codex/install.sh | sh
  say "T3 Code ($T3_CHANNEL)"
  command -v t3 >/dev/null || curl -fsSL https://t3.codes/install.sh | T3CODE_CHANNEL="$T3_CHANNEL" sh
  sudo env "PATH=$PATH" t3 browser setup || warn "browser setup failed; run 'sudo t3 browser setup' and read its message"
  t3 service install || warn "background service didn't start; is systemd on? ('hangar doctor' checks)"
  command -v node >/dev/null || warn "no Node yet: install it, and if you use nvm, put its lines in ~/.profile"
  say ""
  install_dashboard
  say "Next, by hand:"
  say "  claude        sign in, then /exit"
  say "  codex login   (or use 'Connect with ChatGPT' in T3 instead)"
  say "  t3 connect    link this machine to your T3 account"
  say "  hangar setup && hangar doctor"
}

cmd_help() {
  cat <<EOF
hangar: keep this machine's agent setup in step with $REPO

  setup     link config, install skill dependencies; on macOS, build the temperature helper and load the Dashboard reporter;
            on the PC, set up HWiNFO64 for the CPU temperature (one UAC prompt), start Ubuntu at sign-in
            and keep the PC awake after a remote wake
  sync      commit this machine's changes, pull the other machine's, push, apply
  doctor    check links, PATH, T3 service, browser, WSL, Dashboard and temperature
  update    update tools and skills; rebuild and restart Dashboard on Linux
            'update <id>...' updates just those: t3 claude codex gh tea hangar
  outdated  list tools with a newer version; '--json' is what the Dashboard reads
  install   Linux only: install tools, T3 Code and Dashboard; serve through Tailscale
EOF
}

case "${1:-help}" in
  setup) cmd_setup ;; sync) cmd_sync ;; doctor) cmd_doctor ;;
  update) shift; cmd_update "$@" ;; outdated) shift; cmd_outdated "$@" ;;
  _refresh) refresh_hangar ;;   # internal: the second half of 'update hangar', run by the new code
  install) cmd_install ;; *) cmd_help ;;
esac
